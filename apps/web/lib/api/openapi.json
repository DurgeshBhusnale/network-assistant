            "title": "Ends On"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "pack_id": {
            "title": "Pack Id",
            "type": "string"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          },
          "starts_on": {
            "format": "date",
            "title": "Starts On",
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "paused",
              "done"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "pack_id",
          "params",
          "status",
          "starts_on",
          "ends_on",
          "day_number",
          "days_left"
        ],
        "title": "GoalOut",
        "type": "object"
      },
      "GoalUpdate": {
        "additionalProperties": false,
        "properties": {
          "params": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Params"
          },
          "status": {
            "anyOf": [
              {
                "enum": [
                  "active",
                  "paused",
                  "done"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          }
        },
        "title": "GoalUpdate",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "db": {
            "enum": [
              "ok",
              "down"
            ],
            "title": "Db",
            "type": "string"
          },
          "redis": {
            "enum": [
              "ok",
              "down"
            ],
            "title": "Redis",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "db",
          "redis"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "PackOut": {
        "properties": {
          "copy_text": {
            "additionalProperties": true,
