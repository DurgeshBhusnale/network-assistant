{
  "components": {
    "schemas": {
      "ConsentState": {
        "properties": {
          "granted": {
            "title": "Granted",
            "type": "boolean"
          },
          "granted_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Granted At"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "granted",
          "version",
          "granted_at"
        ],
        "title": "ConsentState",
        "type": "object"
      },
      "ConsentsOut": {
        "properties": {
          "consents": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ConsentState"
            },
            "propertyNames": {
              "enum": [
                "contacts",
                "voice",
                "whatsapp",
                "analytics"
              ]
            },
            "title": "Consents",
            "type": "object"
          },
          "notice_accepted": {
            "title": "Notice Accepted",
            "type": "boolean"
          },
          "notice_version": {
            "title": "Notice Version",
            "type": "string"
          }
        },
        "required": [
          "notice_version",
          "notice_accepted",
          "consents"
        ],
        "title": "ConsentsOut",
        "type": "object"
      },
      "ConsentsUpdate": {
        "additionalProperties": false,
        "properties": {
          "accept_notice": {
            "title": "Accept Notice",
            "type": "boolean"
          },
          "consents": {
            "additionalProperties": {
              "type": "boolean"
            },
            "propertyNames": {
              "enum": [
                "contacts",
                "voice",
                "whatsapp",
                "analytics"
              ]
            },
            "title": "Consents",
            "type": "object"
          }
        },
        "required": [
          "accept_notice",
          "consents"
        ],
        "title": "ConsentsUpdate",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "VALIDATION_ERROR",
          "UNAUTHENTICATED",
          "FORBIDDEN",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "CONFLICT",
          "RATE_LIMITED",
          "HTTP_ERROR",
          "PRIVACY_NOTICE_REQUIRED",
          "PACK_NOT_AVAILABLE",
          "GOAL_ALREADY_ACTIVE",
          "INTERNAL_ERROR"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "GoalCreate": {
        "additionalProperties": false,
        "properties": {
          "pack_id": {
            "title": "Pack Id",
            "type": "string"
          },
          "params": {
            "additionalProperties": true,
