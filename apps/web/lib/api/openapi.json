            "type": "object"
          }
        },
        "required": [
          "pack_id",
          "params"
        ],
        "title": "GoalCreate",
        "type": "object"
      },
      "GoalOut": {
        "properties": {
          "day_number": {
            "description": "1-based day of the goal in the user's timezone",
