# Copy to .env and fill in. Never commit .env.
# Values below are placeholders or safe local defaults.

# --- General ---
APP_ENV=local                      # local | staging | production
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
ADMIN_USER_IDS=                    # comma-separated Supabase user ids allowed on /admin
LOG_LEVEL=INFO
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Supabase ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # server only
SUPABASE_JWKS_URL=                 # e.g. ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=               # only if the project uses legacy symmetric JWT signing
# Dev: the cloud dev project's Session pooler string (Connect → Session pooler, port 5432).
# Plain postgresql:// is fine; the API adds the asyncpg driver.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Per process (API and worker each). Session pooler caps total clients (~15 on the dev plan).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
STORAGE_BUCKET_CAPTURES=captures

# --- Redis / workers ---
REDIS_URL=redis://localhost:6379/0

# --- AI ---
AI_MODE=fake                       # fake | live  (tests and CI must use fake)
# Groq only in v1 (ADR-0010). Fallbacks are a second Groq model.
GROQ_API_KEY=
MODEL_SMALL=openai/gpt-oss-20b            # extraction, relevance, factcheck, style
MODEL_FALLBACK_SMALL=openai/gpt-oss-120b
MODEL_DRAFT=openai/gpt-oss-120b           # drafts (all tiers)
MODEL_FALLBACK_DRAFT=openai/gpt-oss-20b
MODEL_STT=whisper-large-v3-turbo
MODEL_STT_FALLBACK=whisper-large-v3
AI_TIMEOUT_LLM_SECONDS=20
AI_TIMEOUT_STT_SECONDS=60

# --- WhatsApp Cloud API (Meta, direct) ---
WA_GRAPH_VERSION=                  # e.g. v2X.0 — use the current version from Meta docs
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=                   # permanent system-user token
WA_APP_SECRET=                     # for X-Hub-Signature-256 verification
WA_VERIFY_TOKEN=                   # any random string, also set in Meta webhook config
WA_DISPLAY_NUMBER=                 # our number in E.164 digits, used in wa.me links (e.g. 9198xxxxxxxx)
WA_BRIEFS_ENABLED=false

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
PRICE_SPRINT_PAISE=79900
PRICE_PRO_MONTHLY_PAISE=29900
PRICE_PRO_YEARLY_PAISE=249900
SPRINT_DAYS=60
SPRINT_FAIR_USE_DRAFTS=400
FREE_DRAFTS_PER_MONTH=3
FREE_REGENERATIONS_PER_DRAFT=3
DAILY_SEND_CAP=20
RATE_LIMIT_GENERAL_PER_MINUTE=60     # per user (tech spec §6)
PRO_ENABLED=false
PRICE_TEST_ENABLED=false

# --- Notifications ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
RESEND_API_KEY=
EMAIL_FROM="[App name] <hello@example.com>"

# --- Privacy ---
PRIVACY_NOTICE_VERSION=2026-10-25   # bump when notice text changes; users re-accept
CONSENT_VERSION=2026-10-25

# --- WhatsApp extras ---
WA_TEMPLATE_LANGUAGE=en             # language code the templates were approved in
WA_LINK_CODE_MINUTES=15

# --- Notifications extras ---
UNSUBSCRIBE_SECRET=                 # random string; signs one-click unsubscribe links
DIGEST_WEEKDAY=0                    # 0 = Monday
DIGEST_HOUR=9
