# Copy to .env and fill in. Never commit .env.
# Values below are placeholders or safe local defaults.

# --- General ---
APP_ENV=local                      # local | staging | production
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
ADMIN_USER_IDS=                    # comma-separated Supabase user ids allowed on /admin
LOG_LEVEL=INFO
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Supabase ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # server only
SUPABASE_JWKS_URL=                 # e.g. ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=               # only if the project uses legacy symmetric JWT signing
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
STORAGE_BUCKET_CAPTURES=captures

# --- Redis / workers ---
REDIS_URL=redis://localhost:6379/0

# --- AI ---
AI_MODE=fake                       # fake | live  (tests and CI must use fake)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
SARVAM_API_KEY=
OPENAI_API_KEY=                    # STT fallback only
MODEL_SMALL=openai/gpt-oss-20b     # extraction, relevance, factcheck, style (Groq)
MODEL_DRAFT=openai/gpt-oss-120b    # default drafts (Groq)
MODEL_DRAFT_PREMIUM=claude-sonnet-5-5
MODEL_FALLBACK_SMALL=claude-haiku-5-5
MODEL_STT=whisper-large-v3-turbo   # Groq
MODEL_STT_INDIC=                   # Sarvam STT model id (confirm in Sarvam docs)
MODEL_STT_FALLBACK=gpt-4o-mini-transcribe
AI_TIMEOUT_LLM_SECONDS=20
AI_TIMEOUT_STT_SECONDS=60

# --- WhatsApp Cloud API (Meta, direct) ---
WA_GRAPH_VERSION=                  # e.g. v2X.0 — use the current version from Meta docs
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=                   # permanent system-user token
WA_APP_SECRET=                     # for X-Hub-Signature-256 verification
WA_VERIFY_TOKEN=                   # any random string, also set in Meta webhook config
WA_DISPLAY_NUMBER=                 # our number in E.164 digits, used in wa.me links (e.g. 9198xxxxxxxx)
WA_BRIEFS_ENABLED=false

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
PRICE_SPRINT_PAISE=79900
PRICE_PRO_MONTHLY_PAISE=29900
PRICE_PRO_YEARLY_PAISE=249900
SPRINT_DAYS=60
SPRINT_FAIR_USE_DRAFTS=400
FREE_DRAFTS_PER_MONTH=3
DAILY_SEND_CAP=20
PRO_ENABLED=false
PRICE_TEST_ENABLED=false

# --- Notifications ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
RESEND_API_KEY=
EMAIL_FROM="[App name] <hello@example.com>"
